// Receipt platform — PostgreSQL schema
//
// Tenant isolation is structural: every tenant-owned row carries business_id
// and every query in the API is forced through a scope guard (see src/lib/prisma.ts).
//
// `Business` IS the organization/tenant. There is deliberately no separate
// Organization model: a business owns its users, customers and receipts, and
// the session JWT mints business_id at login so no route ever trusts an
// organization id supplied by the client.

generator client {
  provider = "prisma-client-js"
  // `native` = the machine running `prisma generate` (Windows in local dev).
  // Render runs the built image on Debian 12 / OpenSSL 3.0, and a client built
  // for `debian-openssl-1.1.x` cannot load there — the API would die at boot with
  // PrismaClientInitializationError and take Next.js down with it. Listing the
  // target explicitly makes `prisma generate` fetch that engine by name instead
  // of relying on OpenSSL detection, which is what mis-detected 1.1.x in the
  // build container.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Membership role. See `@eleos/shared#rbac` for the permission matrix that
/// turns this into an authorization decision — the enum itself is only the
/// label, and the matrix is the rule.
///
/// `owner` and `staff` keep their pre-RBAC meaning exactly, so the migration
/// below is additive and existing rows keep their access.
enum Role {
  owner
  admin
  staff
  viewer
}

enum PaymentMethod {
  cash
  transfer
  card
  other
}

enum PaymentStatus {
  paid
  partial
  pending
}

enum ReceiptStatus {
  active
  void
}

/// What produced a receipt. `standalone` is a point-of-sale document;
/// `invoice_payment` is generated from a payment recorded against an invoice.
enum ReceiptSource {
  standalone
  invoice_payment
}

/// Invoice lifecycle. `overdue` is *derived* — see `refreshInvoiceStatus` —
/// but it is stored so the list can filter on it without recomputing per row.
enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  cancelled
}

model Business {
  id              String   @id @default(uuid())
  name            String
  logo_url        String?
  address         String?
  phone           String?
  email           String?
  /// Public site shown on receipts and the verification page.
  website         String?
  currency        String   @default("NGN")
  brand_primary   String   @default("#111111")
  brand_accent    String   @default("#B8912F")
  /// Prefix used when composing receipt numbers, e.g. ES → ES-000214
  number_prefix   String   @default("ES")
  /// Monotonic counter. Incremented under a row lock so numbers are unique
  /// AND gap-free per business even when requests race.
  receipt_counter Int      @default(0)
  /// Same scheme as `receipt_counter`, for the `INV-000001` series. Kept as a
  /// separate column so the two document series can never interfere.
  invoice_counter Int      @default(0)
  /// ── Document watermarking ─────────────────────────────────────────────
  /// The VisionaryGene watermark is on by default: the platform is operated by
  /// VisionaryGene and the documents it renders are attributed to it. An
  /// organization may set its own text or turn it off entirely; both are
  /// owner-only settings enforced in the API, never from the client.
  watermark_enabled Boolean @default(true)
  watermark_text    String   @default("VISIONARYGENE")
  /// 0–100. Clamped by the update schema so a tenant can never make the
  /// watermark opaque enough to obscure its own financial figures.
  watermark_opacity Int      @default(8)
  created_at      DateTime @default(now())
  /// `DEFAULT now()` so pre-existing rows are backfilled by the migration.
  updated_at      DateTime @default(now()) @updatedAt

  users      User[]
  customers  Customer[]
  receipts   Receipt[]
  invoices   Invoice[]
  invoice_payments InvoicePayment[]
  invitations Invitation[]
  audit_events AuditEvent[]

  @@map("businesses")
}

model User {
  id            String   @id @default(uuid())
  business_id   String
  full_name     String
  email         String   @unique
  password_hash String
  phone         String?
  role          Role     @default(owner)
  created_at    DateTime @default(now())

  business      Business  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  receipts      Receipt[]
  invoices      Invoice[]
  invoice_payments InvoicePayment[]
  /// Invitations this person sent.
  sent_invitations Invitation[] @relation("InvitedBy")
  /// Audit entries this person produced.
  audit_events  AuditEvent[]

  @@index([business_id])
  @@map("users")
}

model Customer {
  id           String   @id @default(uuid())
  business_id  String
  name         String
  phone        String?
  email        String?
  created_at   DateTime @default(now())

  business   Business   @relation(fields: [business_id], references: [id], onDelete: Cascade)
  receipts   Receipt[]
  invoices   Invoice[]

  @@index([business_id])
  @@index([business_id, name])
  @@map("customers")
}

model Receipt {
  id                String        @id @default(uuid())
  business_id       String
  customer_id       String?
  /// Unique per business, never globally: ES-000214
  receipt_number    String
  /// A standalone sale, or the acknowledgement of a payment against an
  /// invoice. Both are real receipts and both print identically; the flag
  /// exists so history can tell them apart and so an invoice payment receipt
  /// can be traced back to the payment that caused it.
  source            ReceiptSource @default(standalone)
  /// Set when this receipt acknowledges a payment on an invoice. Unique
  /// because one payment yields at most one receipt — that uniqueness is what
  /// makes double-generation impossible even under concurrent requests.
  invoice_payment_id String? @unique
  issue_date        DateTime      @default(now())
  subtotal          Decimal       @db.Decimal(14, 2)
  discount          Decimal       @default(0) @db.Decimal(14, 2)
  tax               Decimal       @default(0) @db.Decimal(14, 2)
  /// Percentage rate used to derive `tax`, kept so the document can render "VAT 7.5%"
  tax_rate          Decimal       @default(0) @db.Decimal(5, 2)
  total             Decimal       @db.Decimal(14, 2)
  /// Amount actually received — gives `payment_status: partial` a meaning.
  paid_amount       Decimal       @default(0) @db.Decimal(14, 2)
  payment_method    PaymentMethod @default(cash)
  payment_status    PaymentStatus @default(paid)
  status            ReceiptStatus @default(active)
  notes             String?
  /// Set once the branded PDF has been rendered and stored.
  pdf_url           String?
  /// Audit trail for void + reissue. Rows are never deleted.
  voided_at         DateTime?
  void_reason       String?
  /// The voided receipt this one replaces (reissue chain).
  original_receipt_id String?
  created_by        String
  created_at        DateTime      @default(now())

  business        Business     @relation(fields: [business_id], references: [id], onDelete: Cascade)
  customer        Customer?    @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  created_by_user User         @relation(fields: [created_by], references: [id], onDelete: Restrict)
  original_receipt Receipt?    @relation("Reissue", fields: [original_receipt_id], references: [id], onDelete: SetNull)
  reissues         Receipt[]    @relation("Reissue")
  items            ReceiptItem[]
  /// The payment this receipt acknowledges, when `source = invoice_payment`.
  /// This side owns the foreign key because the receipt detail screen is the
  /// hot path — it loads the payment in the same query as the document.
  /// `Restrict`: a payment is a financial record, so deleting one must never
  /// silently delete the document that proves it happened.
  invoice_payment  InvoicePayment? @relation(fields: [invoice_payment_id], references: [id], onDelete: Restrict)

  /// The database, not the application, is the final authority on numbering.
  @@unique([business_id, receipt_number])
  @@index([business_id, created_at])
  @@index([business_id, status])
  @@index([business_id, issue_date])
  @@index([invoice_payment_id])
  @@map("receipts")
}

model ReceiptItem {
  id          String  @id @default(uuid())
  receipt_id  String
  /// Keeps line order stable in the rendered document.
  position    Int     @default(0)
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unit_price  Decimal @db.Decimal(14, 2)
  line_total  Decimal @db.Decimal(14, 2)

  receipt Receipt @relation(fields: [receipt_id], references: [id], onDelete: Cascade)

  @@index([receipt_id])
  @@map("receipt_items")
}

/// An invoice: goods/services owed, with a lifecycle and a payment history.
///
/// Like a receipt, an issued invoice is immutable in its money fields — a
/// correction is cancel + reissue, never an edit of a document the customer
/// may already have paid against. A `draft` is the one editable state.
model Invoice {
  id           String        @id @default(uuid())
  business_id  String
  customer_id  String?
  /// Unique per business, never globally: INV-000042.
  invoice_number String
  issue_date   DateTime      @default(now())
  due_date     DateTime?
  subtotal     Decimal       @db.Decimal(14, 2)
  discount     Decimal       @default(0) @db.Decimal(14, 2)
  tax          Decimal       @default(0) @db.Decimal(14, 2)
  tax_rate     Decimal       @default(0) @db.Decimal(5, 2)
  total        Decimal       @db.Decimal(14, 2)
  /// Sum of the payments recorded against this invoice. Denormalised so the
  /// list and dashboard can sort and sum without a per-row aggregate, and
  /// rewritten inside the same transaction that records a payment.
  amount_paid  Decimal       @default(0) @db.Decimal(14, 2)
  status       InvoiceStatus @default(draft)
  notes        String?
  /// Payment terms shown on the document, e.g. "Net 30".
  terms        String?
  /// The customer's own purchase-order reference, when they gave one.
  po_reference String?
  /// Set once the branded PDF has been rendered and stored.
  pdf_url      String?
  /// Frozen at issue time. See the note on the model.
  issued_snapshot Json?
  issued_at    DateTime?
  /// Cancellation is a business event, not a delete: the row and its payment
  /// history are retained so the ledger still reconciles.
  cancelled_at DateTime?
  cancel_reason String?
  created_by   String
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  business        Business        @relation(fields: [business_id], references: [id], onDelete: Cascade)
  customer        Customer?       @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  created_by_user User            @relation(fields: [created_by], references: [id], onDelete: Restrict)
  items           InvoiceItem[]
  payments        InvoicePayment[]

  @@unique([business_id, invoice_number])
  @@index([business_id, created_at])
  @@index([business_id, status])
  @@index([business_id, issue_date])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoice_id  String
  /// Keeps line order stable in the rendered document.
  position    Int     @default(0)
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unit_price  Decimal @db.Decimal(14, 2)
  line_total  Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([invoice_id])
  @@map("invoice_items")
}

/// One payment received against an invoice.
///
/// Several payments may settle one invoice (deposit, part-payment, balance),
/// and each one can carry its own generated receipt, so this — not the
/// invoice — is the unit of receipt generation. `amount` is stored rather
/// than derived so history stays readable after a correction.
model InvoicePayment {
  id          String        @id @default(uuid())
  business_id String
  invoice_id  String
  amount      Decimal       @db.Decimal(14, 2)
  paid_at     DateTime      @default(now())
  method      PaymentMethod @default(cash)
  /// The customer's own reference for this payment (transfer ref, cheque no).
  reference   String?
  notes       String?
  created_by  String
  created_at  DateTime      @default(now())

  business Business  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  invoice  Invoice   @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [created_by], references: [id], onDelete: Restrict)
  /// Inverse of `Receipt.invoice_payment` — this payment's generated receipt,
  /// if one was requested at the time.
  receipt  Receipt?  @relation

  @@index([business_id, created_at])
  @@index([invoice_id, paid_at])
  @@map("invoice_payments")
}

/// A pending invitation to join one organization.
///
/// The token is the authorisation: it is random, stored only as a SHA-256
/// hash, single-use, and expires. An invitee therefore proves nothing about
/// who they are until they redeem it, and a leaked database row is useless
/// because the plaintext token never existed in it.
model Invitation {
  id           String   @id @default(uuid())
  business_id  String
  email        String
  /// The role the invitee will hold if they accept. Capped at `admin` at the
  /// route boundary — inviting an owner is an ownership transfer, not an invite.
  role         Role     @default(staff)
  /// SHA-256 of the token. The plaintext is returned exactly once, at creation.
  token_hash   String   @unique
  invited_by   String
  expires_at   DateTime
  /// `null` until the invite is used, then stamped with when.
  accepted_at  DateTime?
  /// Who redeemed it. Null while pending; set even if the account was later
  /// removed, so the trail survives the person.
  accepted_by  String?
  revoked_at   DateTime?
  created_at   DateTime @default(now())

  business     Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  invited_by_user User  @relation("InvitedBy", fields: [invited_by], references: [id], onDelete: Restrict)

  @@unique([business_id, email])
  @@index([business_id, created_at])
  @@index([email])
  @@map("invitations")
}

/// An append-only record of a significant business event.
///
/// Deliberately not a log table anyone may edit: rows are only ever inserted,
/// there is no update or delete route anywhere in the API, and every query is
/// filtered by `business_id` so one organization can never read another's
/// trail. `metadata` holds change detail only — never a password, token or
/// customer payment detail.
model AuditEvent {
  id           String   @id @default(uuid())
  business_id  String
  /// Null for system events that have no human actor (e.g. a scheduled sweep).
  actor_id     String?
  /// Dotted verb, e.g. `invoice.issue`. Kept as a string rather than an enum
  /// so a new event can be recorded without a migration.
  action       String
  /// What it happened to: `invoice`, `receipt`, `user`, `business`…
  resource_type String?
  resource_id  String?
  metadata     Json?
  created_at   DateTime @default(now())

  business     Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  actor        User?    @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([business_id, created_at])
  @@index([business_id, action])
  @@index([resource_type, resource_id])
  @@map("audit_events")
}
