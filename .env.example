# ---------------------------------------------------------------------------
# Eleosstyles Receipt System — environment
# Copy to .env and fill in. Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- API -------------------------------------------------------------------
# Port the API listens on. API_PORT wins when set; otherwise PORT is used
# (PaaS providers set PORT), falling back to 4000.
API_PORT=4000

# Browser origins allowed by CORS (comma separated). Only needed when a browser
# app on another origin calls the API — requests with no Origin header (curl,
# server-to-server, PDF fetchers) are never checked. Leave empty to reject every
# browser origin, which is the safe default for a backend with no UI of its own.
API_ORIGIN=

# Secret used to sign JWTs and public share tokens.
# MUST be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-32-chars-minimum

# JWT lifetime in seconds (default 7 days)
JWT_TTL_SECONDS=604800

# Public share links expire after this many seconds (default 7 days)
SHARE_TTL_SECONDS=604800

# --- Database (PostgreSQL) --------------------------------------------------
# Local dev uses the embedded PostgreSQL started by `npm run db:start`.
DATABASE_URL=postgresql://eleos:eleos@127.0.0.1:5433/eleosstyles

# Name of the database created by `npm run db:setup`
DATABASE_NAME=eleosstyles
# Local dev database password (used by `npm run db:start`)
DATABASE_PASSWORD=eleos
DATABASE_USER=eleos
DATABASE_PORT=5433

# --- Seed owner (required by `npm run db:seed`) ------------------------------
# The seed creates one business and one owner login. There is no built-in
# default — a checked-in demo password would be a real, guessable login on
# every deployment that ran the seed. Set your own before seeding.
SEED_OWNER_EMAIL=you@yourdomain.com
SEED_OWNER_PASSWORD=change-me-to-something-strong
# Set to true to also create sample customers and receipts (dev fixtures only).
# Leave false for a real install — a ledger of invented sales is not data.
SEED_SAMPLE_DATA=false

# --- Public origin ----------------------------------------------------------
# Origin to build share links from, used when the deployment sits behind a
# proxy that rewrites the Host header (e.g. https://receipts.example.com).
# Leave empty to derive the origin from each incoming request.
PUBLIC_API_BASE_URL=

# --- File storage -----------------------------------------------------------
# "local" = write files under apps/api/.storage and serve them through signed URLs
# "s3"    = store in an S3-compatible bucket and serve presigned URLs
STORAGE_DRIVER=local
STORAGE_DIR=

# Required when STORAGE_DRIVER=s3 (any S3-compatible provider works)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Email ------------------------------------------------------------------
# "console" = log the email instead of sending it (default, no account needed)
# "smtp"    = send through any SMTP server (or a provider such as Resend/SES)
MAIL_DRIVER=console
MAIL_FROM="Eleosstyles Receipts <receipts@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- PDF --------------------------------------------------------------------
# Absolute path to a Chromium/Chrome binary. Leave empty to let Puppeteer
# resolve it automatically (bundled Chromium, or the system Chrome channel).
PUPPETEER_EXECUTABLE_PATH=

# --- Misc -------------------------------------------------------------------
NODE_ENV=development

# --- API documentation ------------------------------------------------------
# Swagger UI at GET /api/docs, raw OpenAPI document at GET /api/docs/openapi.json.
# Set to false to take the documentation down (e.g. on a public deployment).
DOCS_ENABLED=true
